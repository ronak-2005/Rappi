# App settings (copy to .env). LLM settings live separately in llm.env.

# SQLite database file shared by read_api (opened read-only) and write_api (read-write)
DATABASE_PATH=var/app.db

# Service URLs (used by write_api to call the other services)
READ_API_URL=http://localhost:8001
SUPPLIER_API_URL=http://localhost:8003

# Business rules file
POLICY_PATH=policy.yaml

# Frontend origin allowed by CORS
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
