# Google AI Studio — free tier (Flash / Flash-Lite models). Key: https://aistudio.google.com/apikey
# OpenAI-compatible endpoint. List models with `make llm-models ENV=llm-examples/gemini.env`.
# Tested 2026-11-02: gemini-3.5-flash and gemini-3.5-flash-lite support tool calls. The newest Flash has a small
# free daily quota (429 with an empty body once used up); Flash-Lite has a separate, larger one.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_MAX_RETRIES=6
LLM_MIN_INTERVAL_S=7      # free tier ≈ 10 requests/min
LLM_RATE_LIMIT_WAITS=4
