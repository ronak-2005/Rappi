# OpenRouter — free model (no credit card). Key: https://openrouter.ai/settings/keys
# Free models are rate-limited (requests per minute / per day) and can disappear; check https://openrouter.ai/models?max_price=0
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MAX_RETRIES=6
LLM_TIMEOUT_S=120
# LLM_MIN_INTERVAL_S=0     # seconds between calls, for per-minute rate limits
# LLM_RATE_LIMIT_WAITS=0   # long waits on per-minute 429s (per-day limits never wait)
