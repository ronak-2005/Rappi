# LLM settings (copy to llm.env — it is gitignored, never commit keys).
# The code only reads these generic fields. Any OpenAI-compatible endpoint works:
# change these lines, restart write_api, done. No code change.

LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Optional (defaults shown)
# live     = call the endpoint above
# scripted = replay fixed tool calls (tests / demo, no key needed)
# baseline = no LLM at all, deterministic policy picks the cheapest feasible option
LLM_MODE=live
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Example base URLs (documentation only — the code never reads these lines):
#   Anthropic (Claude) : https://api.anthropic.com/v1/
#   OpenAI             : https://api.openai.com/v1
#   Groq               : https://api.groq.com/openai/v1
#   OpenRouter         : https://openrouter.ai/api/v1
#   Hugging Face       : https://router.huggingface.co/v1
#   Ollama (local)     : http://localhost:11434/v1   (LLM_API_KEY=ollama)
# ---------------------------------------------------------------------------
# LLM_MIN_INTERVAL_S=0     # seconds between calls, for per-minute rate limits
# LLM_RATE_LIMIT_WAITS=0   # long waits on per-minute 429s (per-day limits never wait)
